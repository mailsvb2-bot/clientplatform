+                REFERENCES business_members(id, business_id),
+            CHECK(status IN ('active','archived'))
+        )
+        """
+    )
+    c.execute(
+        """
+        CREATE TABLE IF NOT EXISTS commercial_ladder_steps(
+            id TEXT PRIMARY KEY,
+            business_id TEXT NOT NULL,
+            ladder_id TEXT NOT NULL,
+            position INTEGER NOT NULL,
+            kind TEXT NOT NULL,
+            title TEXT NOT NULL,
+            offering_id TEXT,
