+    def test_event_payload_rejects_non_finite_json_numbers(self) -> None:
+        lead = self.repo.create_or_refresh_lead(
+            actor=self.owner,
+            opportunity_key="web:nonfinite-json",
+            customer_id=self.customer.id,
+            source_kind="website",
+            contact_basis=ContactBasis.INBOUND,
