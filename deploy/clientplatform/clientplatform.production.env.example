# Dedicated ClientPlatform production environment.
# Copy to /etc/clientplatform/clientplatform.env, chmod 0600, and fill secrets only there.

APP_ENV=prod
CLIENTPLATFORM_ENVIRONMENT=production
CLIENTPLATFORM_DEPLOYMENT_ID=clientplatform-production
CLIENTPLATFORM_DEPLOYMENT_MODE=systemd
CLIENTPLATFORM_CONTAINER_NETWORK_ISOLATED=0
CLIENTPLATFORM_DOMAIN=clientplatform.your-domain.ru
CLIENTPLATFORM_PUBLIC_BASE_URL=https://clientplatform.your-domain.ru
CLIENTPLATFORM_PRODUCTION_BOT_USERNAME=clientplatform_bot

# Telegram process runtime remains enabled by default for backward compatibility.
# Set this to 0 only for an intentional native-only VK/MAX deployment after
# canonical omnichannel ingress is enabled and active Telegram connections are disabled.
CLIENTPLATFORM_TELEGRAM_RUNTIME_ENABLED=1

# Dedicated control bot. Never reuse a staging or imported-product token.
BOT_TOKEN=
ADMIN_IDS=
CLIENTPLATFORM_CONTROL_BOT_ENABLED=1
CLIENTPLATFORM_DISPATCH_RUNTIME_ENABLED=1

# Dedicated PostgreSQL database and least-privilege application role.
CLIENTPLATFORM_DB_ENGINE=postgres
CLIENTPLATFORM_DATABASE_NAME=clientplatform
DATABASE_URL=postgresql://clientplatform_app:CHANGE_ON_SERVER@127.0.0.1:5433/clientplatform
POSTGRES_REUSE_CONNECTIONS=1
ALLOW_SQLITE_IN_PROD=0

# ClientPlatform state must never fall back to /var/lib/clientplatform.
CLIENTPLATFORM_RUNTIME_ROOT=/var/lib/clientplatform/runtime
CLIENTPLATFORM_WRITABLE_ROOT=/var/lib/clientplatform/state
CLIENTPLATFORM_DATA_DIR=/var/lib/clientplatform/state/data
CLIENTPLATFORM_LOGS_DIR=/var/log/clientplatform
MPLCONFIGDIR=/var/lib/clientplatform/state/matplotlib
# Telegram is polling-only when its process runtime is enabled. These values are
# canonical and must not be overridden by stale webhook configuration.
TELEGRAM_TRANSPORT=polling
RUN_MODE=polling
TELEGRAM_WEBHOOK_ENABLED=0
TELEGRAM_LEGACY_TOKEN_WEBHOOK_ENABLED=0
ALLOW_INSECURE_TELEGRAM_WEBHOOK=0

# Shared HTTP ingress behind the owned reverse proxy.
# VK, MAX and privacy exports use this server; Telegram never does.
MESSENGER_WEBHOOK_ENABLED=1
MESSENGER_WEBHOOK_HOST=127.0.0.1
MESSENGER_WEBHOOK_PORT=8181
MESSENGER_PUBLIC_BASE_URL=https://clientplatform.your-domain.ru
PRIVACY_EXPORT_HTTP_ENABLED=1
PRIVACY_EXPORT_PUBLIC_BASE_URL=https://clientplatform.your-domain.ru
PRIVACY_EXPORT_TOKEN_TTL_MINUTES=10
# Canonical tenant-scoped VK/MAX ingress. Enable only after each business
# Connection + ingress route + secret references pass the omnichannel preflight.
# Legacy global /webhooks/vk and /webhooks/max remain disabled by default.
CLIENTPLATFORM_OMNICHANNEL_INGRESS_ENABLED=0
MAX_WEBHOOK_ENABLED=0
MAX_API_BASE_URL=https://platform-api2.max.ru
# MAX production API currently requires trust in the MinDigital CA. If the base
# image/system trust store does not already contain it, place a reviewed PEM at
# ${CLIENTPLATFORM_MANAGED_BOT_CREDENTIAL_HOST_DIR}/max-ca.pem on the host. The
# existing read-only security mount exposes it at the fixed path below; only then
# uncomment MAX_CA_BUNDLE. Production env preparation rejects other container paths.
# MAX_CA_BUNDLE=/run/secrets/clientplatform-managed-bot/max-ca.pem
# MAX may remove a webhook after a prolonged delivery outage. The canonical runtime
# periodically reasserts active tenant routes after the HTTP endpoint is healthy.
CLIENTPLATFORM_MAX_WEBHOOK_RECONCILE_INTERVAL_SEC=21600
CLIENTPLATFORM_MAX_WEBHOOK_RECONCILE_RETRY_SEC=900
CLIENTPLATFORM_MAX_WEBHOOK_RECONCILE_BATCH_SIZE=100
VK_WEBHOOK_ENABLED=0
HTTP_INGRESS_MAX_BODY_BYTES=1048576
CLIENTPLATFORM_NATIVE_WEBHOOK_MAX_BODY_BYTES=262144
CLIENTPLATFORM_NATIVE_WEBHOOK_MAX_INFLIGHT=32
CLIENTPLATFORM_NATIVE_SETUP_MAX_BODY_BYTES=8192
CLIENTPLATFORM_NATIVE_SETUP_MAX_INFLIGHT=4
CLIENTPLATFORM_NATIVE_HTTP_QUEUE_TIMEOUT_MS=100

# Managed Telegram bots are polling-only. The primary onboarding uses Telegram
# Managed Bots: the control bot requests creation natively, fetches the child token
# server-side and stores only age-encrypted ciphertext plus an opaque vault:// ref.
# Keep auto provisioning disabled until the control bot has can_manage_bots enabled
# in Telegram and the private age identity below has been provisioned. BotFather +
# secret://env/CLIENTPLATFORM_SECRET_* remains a fallback for existing bots.
CLIENTPLATFORM_BOT_GATEWAY_ENABLED=1
CLIENTPLATFORM_MANAGED_BOT_AUTO_PROVISIONING_ENABLED=0
CLIENTPLATFORM_MANAGED_BOT_CREDENTIAL_IDENTITY_FILE=/run/secrets/clientplatform-managed-bot/identity.txt
CLIENTPLATFORM_MANAGED_BOT_CREDENTIAL_HOST_DIR=/var/lib/clientplatform/managed-bot-secrets
CLIENTPLATFORM_MANAGED_BOT_CREDENTIAL_ALLOW_GENERATE=0
CLIENTPLATFORM_BOT_GATEWAY_PATH_PREFIX=/clientplatform/managed-bots
CLIENTPLATFORM_BOT_GATEWAY_BATCH_SIZE=10
CLIENTPLATFORM_BOT_GATEWAY_INTERVAL_SEC=0.5
CLIENTPLATFORM_BOT_GATEWAY_TICK_TIMEOUT_SEC=30
CLIENTPLATFORM_BOT_GATEWAY_LOCK_TTL_SEC=300
CLIENTPLATFORM_BOT_GATEWAY_MAX_ATTEMPTS=5
CLIENTPLATFORM_BOT_GATEWAY_PER_BOT_PER_MINUTE=120
CLIENTPLATFORM_BOT_GATEWAY_PER_BOT_QUEUE_LIMIT=1000
CLIENTPLATFORM_BOT_GATEWAY_MAX_PAYLOAD_BYTES=262144
CLIENTPLATFORM_BOT_GATEWAY_POLL_TIMEOUT_SEC=20
CLIENTPLATFORM_BOT_GATEWAY_RECONCILE_INTERVAL_SEC=2

# Versioned Visual Creative Gateway. In the Compose deployment the application is
# routed to the internal visual-gateway service. VISUAL_GATEWAY_TOKEN authenticates
# the app to that internal gateway. The explicit UPSTREAM keys are used by the
# gateway for provider-neutral egress. Existing production installations are
# migrated automatically from the legacy URL/TOKEN pair when the upstream keys are
# absent, without printing or replacing their secret values.
VISUAL_GATEWAY_URL=https://visual-gateway-upstream.example.invalid
VISUAL_GATEWAY_TOKEN=CHANGE_ON_SERVER
VISUAL_GATEWAY_UPSTREAM_URL=https://visual-gateway-upstream.example.invalid
VISUAL_GATEWAY_UPSTREAM_TOKEN=CHANGE_ON_SERVER
# Content recovery never submits a second paid generation. It retries GET for the
# same job only on transient HTTP/transport failures, with exponential backoff and
# deterministic per-job jitter. The deadline is longer for video.
VISUAL_CONTENT_RECOVERY_IMAGE_SECONDS=60
VISUAL_CONTENT_RECOVERY_VIDEO_SECONDS=120
# Transfer timeouts are socket/request safety bounds, not fixed generation waits.
# The visual gateway itself uses an idle timeout while streaming provider media,
# so a large file may take longer overall as long as chunks keep arriving.
VISUAL_CONTENT_TRANSFER_IMAGE_TIMEOUT_SECONDS=60
VISUAL_CONTENT_TRANSFER_VIDEO_TIMEOUT_SECONDS=180
VISUAL_GATEWAY_UPSTREAM_MEDIA_IDLE_TIMEOUT_SECONDS=60

# At least one image provider and one video-capable provider must be configured
# for production readiness. Video providers are split into two capability tiers:
# native video (moving-scene generation) and motion fallback (animated AI keyframe).
# Native providers are preferred before yandexart_motion even if an older order
# listed motion first. For RU the default effective video order is:
# images: yandexart,gigachat,selfhosted
# video:  selfhosted,selfhosted_backup,yandexart_motion
# yandexart_motion reuses YandexART credentials to create one keyframe and ffmpeg
# to render a short MP4. It is a fallback, not text-to-video.
VISUAL_DEPLOYMENT_COUNTRY=RU
# YANDEX_ART_FOLDER_ID=
# Prefer a scoped, durable AI Studio API key for image generation.
# Alice AI ART 3.0 uses the OpenAI-compatible Images API and currently accepts
# provider prompts up to 500 characters; ClientPlatform enforces that bound.
# YANDEX_API_KEY=
# Temporary static IAM-token fallback remains supported when an API key is unavailable.
# YANDEX_ART_IAM_TOKEN=
# Preferred renewable fallback: service-account authorized key -> short-lived IAM token.
# Use a service account with ai.imageGeneration.user (and the matching AI Studio scope/roles).
# YANDEX_ART_AUTHORIZED_KEY_JSON={"id":"...","service_account_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}
# Or mount a root-managed authorized-key file. The production visual provider gets
# read-only access to the canonical Yandex secret mount.
# YANDEX_ART_AUTHORIZED_KEY_FILE=/run/secrets/clientplatform-yandex-billing/authorized-key.json
# If neither ART-specific source is configured, the visual provider may reuse the
# YANDEX_BILLING_AUTHORIZED_KEY_* source only when that service account also has
# image-generation permission. A definitive 401/403 may fail over to renewable IAM
# only before provider acceptance, so retries cannot duplicate a paid generation.
# Model candidates are tried in order only after definitive pre-acceptance
# rejections. Deprecated YandexART aliases are ignored even if left in a stale
# candidate list unless an operator explicitly sets YANDEX_ALLOW_DEPRECATED_ART_MODELS=1.
# YANDEX_ART_MODEL_CANDIDATES=art://<folder>/aliceai-image-art-3.0
# Primary image pipeline: Alice AI LLM -> Responses API image_generation -> Alice AI ART.
# YANDEX_ART_PIPELINE=responses
# YANDEX_IMAGE_ORCHESTRATOR_MODEL=gpt://<folder>/aliceai-llm
# YANDEX_ART_RESPONSES_QUALITY=high
# Controlled rollback only:
# YANDEX_ART_PIPELINE=images
# YANDEX_ALLOW_DEPRECATED_ART_MODELS=0
# ClientPlatform also polls the official AI Studio model catalog and reports
# disappearance/new art:// models to superadmins. Keep this credential separate
# from the image-generation key when the generation key is restricted to
# yc.ai.imageGeneration.execute. For the AI Studio catalog endpoint, use a key
# whose scope permits general AI Studio API access (for example
# yc.ai.foundationModels.execute) and grant the service account the model-listing
# permission required by Yandex Cloud. If omitted, the generation credential is
# used for backward compatibility and a narrowly scoped image-only key may return 403.
# YANDEX_MODEL_CATALOG_API_KEY=
# YANDEX_MODEL_CATALOG_AUTH_SCHEME=Api-Key
YANDEX_MODEL_CATALOG_TTL_SECONDS=900
# Optional lifecycle metadata can be updated without a code release:
# VISUAL_MODEL_LIFECYCLE_JSON={"aliceai-image-art-3.0":{"deprecated_at":"2027-01-01","replacement":"next-model"}}
VISUAL_PROVIDER_CIRCUIT_SECONDS=900
# New image receipts can run one advisory semantic QA call after successful delivery.
# The gateway claims that review durably before provider I/O, so retries/redelivery
# cannot repeat the call. QA never creates media and never auto-regenerates an image.
VISUAL_SEMANTIC_QA_ENABLED=1
VISUAL_SEMANTIC_QA_TIMEOUT_SECONDS=45
# Semantic QA reuses the existing GigaChat visual-provider credentials and CA bundle:
# GIGACHAT_CREDENTIALS=
# VISUAL_GIGACHAT_BASE_URL=https://api.giga.chat/v1
# VISUAL_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# VISUAL_GIGACHAT_CA_BUNDLE_FILE=
# VISUAL_GIGACHAT_MODEL=GigaChat-2-Pro
# VISUAL_RU_IMAGE_ORDER=yandexart,gigachat,selfhosted
# VISUAL_RU_VIDEO_ORDER=selfhosted,selfhosted_backup,yandexart_motion
# Set only if the operator intentionally wants the cheaper motion renderer first:
# VISUAL_VIDEO_MOTION_PRIMARY=0
# Recommended Russia-resident native path: an operator-owned GPU worker (Wan or
# another approved video model) behind the normalized self-hosted contract.
# VISUAL_SELFHOST_BASE_URL=http://video-worker.internal:9000
# VISUAL_SELFHOST_TOKEN=
# VISUAL_SELFHOST_VIDEO_MODEL=wan2.2-t2v-a14b
# Independent backup worker (different host/GPU/runtime, same normalized contract):
# VISUAL_SELFHOST_BACKUP_BASE_URL=http://video-worker-backup.internal:9000
# VISUAL_SELFHOST_BACKUP_TOKEN=
# VISUAL_SELFHOST_BACKUP_VIDEO_MODEL=wan2.2-t2v-a14b
# Optional global native providers remain explicit opt-in for RU:
# VISUAL_ALLOW_GLOBAL_PROVIDERS_IN_RU=0
# RUNWAYML_API_SECRET=
# RUNWAY_VIDEO_MODEL=gen4.5
# VISUAL_OPENAI_API_KEY=
# VISUAL_OPENAI_VIDEO_MODEL=

# Optional read-only Yandex Billing telemetry for superadmin balance alerts.
# Billing API requires Bearer IAM authorization. Production should use an
# authorized-key JSON so ClientPlatform renews IAM tokens automatically.
# Give this service account only the read-only billing role it needs.
# YANDEX_BILLING_ACCOUNT_ID=
# Preferred: the JSON returned when a service-account authorized key is created.
# YANDEX_BILLING_AUTHORIZED_KEY_JSON={"id":"...","service_account_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}
# Or mount the same JSON as a root-managed secret file:
# YANDEX_BILLING_AUTHORIZED_KEY_FILE=/run/secrets/clientplatform-yandex-billing/authorized-key.json
# Host directory for the mounted key file when using file-based auth:
# CLIENTPLATFORM_YANDEX_BILLING_SECRET_HOST_DIR=/var/lib/clientplatform/yandex-billing-secrets
# Compatibility fallback only; a static IAM token expires and will trigger a warning.
# YANDEX_BILLING_IAM_TOKEN=
YANDEX_BILLING_ALERT_THRESHOLDS=5000,2000,1000,500,100,0

# Optional provider-neutral advisory Sales AI. It remains off until BOTH this
# server switch and an explicit per-business owner consent are enabled. The model
# can analyze/draft only; it never sends customer messages or owns sales state.
CLIENTPLATFORM_SALES_AI_ENABLED=0
CLIENTPLATFORM_SALES_AI_PROVIDER=deepseek
CLIENTPLATFORM_SALES_AI_MODEL=deepseek-v4-flash
CLIENTPLATFORM_SALES_AI_BASE_URL=https://api.deepseek.com
CLIENTPLATFORM_SALES_AI_API_KEY_REFERENCE=secret://env/CLIENTPLATFORM_SECRET_SALES_AI_DEEPSEEK_API_KEY
CLIENTPLATFORM_SECRET_SALES_AI_DEEPSEEK_API_KEY=
CLIENTPLATFORM_SALES_AI_ALLOW_CUSTOM_ENDPOINT=0
CLIENTPLATFORM_SALES_AI_ALLOWED_HOSTS=
CLIENTPLATFORM_SALES_AI_TIMEOUT_SEC=20
CLIENTPLATFORM_SALES_AI_MAX_OUTPUT_TOKENS=900
CLIENTPLATFORM_SALES_AI_MAX_MESSAGE_CHARS=6000
CLIENTPLATFORM_SALES_AI_BATCH_SIZE=1
CLIENTPLATFORM_SALES_AI_INTERVAL_SEC=1.0
CLIENTPLATFORM_SALES_AI_LOCK_TTL_SEC=120
CLIENTPLATFORM_SALES_AI_MAX_ATTEMPTS=5
CLIENTPLATFORM_SALES_AI_RAW_MESSAGE_TTL_HOURS=168
CLIENTPLATFORM_SALES_AI_ANALYSIS_TTL_DAYS=90

# Optional OpenAI adapter:
# CLIENTPLATFORM_SALES_AI_PROVIDER=openai
# CLIENTPLATFORM_SALES_AI_MODEL=<approved-model-id>
# CLIENTPLATFORM_SALES_AI_BASE_URL=https://api.openai.com/v1
# CLIENTPLATFORM_SALES_AI_API_KEY_REFERENCE=secret://env/CLIENTPLATFORM_SECRET_SALES_AI_OPENAI_API_KEY
# CLIENTPLATFORM_SECRET_SALES_AI_OPENAI_API_KEY=

# Optional compatible provider; both explicit switch + exact host allowlist required:
# CLIENTPLATFORM_SALES_AI_PROVIDER=openai_compatible
# CLIENTPLATFORM_SALES_AI_MODEL=<provider-model-id>
# CLIENTPLATFORM_SALES_AI_BASE_URL=https://provider.example/v1
# CLIENTPLATFORM_SALES_AI_ALLOW_CUSTOM_ENDPOINT=1
# CLIENTPLATFORM_SALES_AI_ALLOWED_HOSTS=provider.example
# CLIENTPLATFORM_SALES_AI_API_KEY_REFERENCE=secret://env/CLIENTPLATFORM_SECRET_SALES_AI_API_KEY
# CLIENTPLATFORM_SECRET_SALES_AI_API_KEY=

# Dedicated health/readiness endpoint. Full diagnostics require a separate token.
HEALTHCHECK_ENABLED=1
HEALTHCHECK_HOST=127.0.0.1
HEALTHCHECK_PORT=8182
HEALTHCHECK_DIAGNOSTICS_TOKEN=

# Dedicated private S3-compatible object storage.
CLIENTPLATFORM_STORAGE_BUCKET=clientplatform-production
CLIENTPLATFORM_MEDIA_GATEWAY_ENABLED=1
CLIENTPLATFORM_MEDIA_GATEWAY_HOST=127.0.0.1
CLIENTPLATFORM_MEDIA_GATEWAY_PORT=8191
CLIENTPLATFORM_MEDIA_GATEWAY_BASE_URL=https://clientplatform.your-domain.ru/clientplatform
CLIENTPLATFORM_MEDIA_GATEWAY_STORAGE_MODE=s3
CLIENTPLATFORM_MEDIA_GATEWAY_ALLOWED_BUCKETS=clientplatform-production
CLIENTPLATFORM_MEDIA_GATEWAY_S3_ENDPOINT=https://s3.your-provider.ru
CLIENTPLATFORM_MEDIA_GATEWAY_S3_REGION=ru-central1
CLIENTPLATFORM_MEDIA_GATEWAY_S3_ACCESS_KEY_REFERENCE=secret://env/CLIENTPLATFORM_SECRET_S3_ACCESS_KEY
CLIENTPLATFORM_MEDIA_GATEWAY_S3_SECRET_KEY_REFERENCE=secret://env/CLIENTPLATFORM_SECRET_S3_SECRET_KEY
CLIENTPLATFORM_MEDIA_SIGNING_SECRET_REFERENCE=secret://env/CLIENTPLATFORM_SECRET_MEDIA_SIGNING_KEY
CLIENTPLATFORM_SECRET_S3_ACCESS_KEY=
CLIENTPLATFORM_SECRET_S3_SECRET_KEY=
CLIENTPLATFORM_SECRET_MEDIA_SIGNING_KEY=
CLIENTPLATFORM_S3_VERSIONING_ENABLED=1

# Media uploaded to the control bot must be copied into private storage before a
# program record is written. Telegram file_id values are bot-specific and are never
# persisted as portable lesson media. getFile currently limits downloads to 20 MB.
CLIENTPLATFORM_PROGRAM_MEDIA_INGEST_ENABLED=1
CLIENTPLATFORM_PROGRAM_MEDIA_MAX_BYTES=20000000
CLIENTPLATFORM_PROGRAM_MEDIA_TIMEOUT_SEC=30

# A separate private, versioned bucket is required for backup replication.
# Keep the evidence flag at 0 until scripts/clientplatform_s3_replication.py prove succeeds.
CLIENTPLATFORM_S3_BACKUP_BUCKET=clientplatform-backup
CLIENTPLATFORM_S3_REPLICATION_EVIDENCE_DIR=/var/lib/clientplatform/s3-replication-evidence
CLIENTPLATFORM_S3_REPLICATION_TIMEOUT_SEC=30
CLIENTPLATFORM_S3_REPLICATION_MAX_COPY_BYTES=5000000000
CLIENTPLATFORM_S3_BACKUP_REPLICATION_ENABLED=0

# PostgreSQL backup and tested-restore contract. Generate an age X25519 identity
# offline, store its private key outside the application environment, and put only
# the public age1... recipient below. Plaintext dumps are deleted after encryption.
# All pg_dump/pg_restore/psql calls are pinned to one verified major release.
CLIENTPLATFORM_POSTGRES_CLIENT_MAJOR=16
CLIENTPLATFORM_BACKUP_DIR=/var/backups/clientplatform/postgres
CLIENTPLATFORM_RESTORE_EVIDENCE_DIR=/var/lib/clientplatform/restore-evidence
CLIENTPLATFORM_BACKUP_RETENTION_DAYS=30
CLIENTPLATFORM_BACKUP_ENCRYPTION_REQUIRED=1
CLIENTPLATFORM_BACKUP_AGE_RECIPIENT=
CLIENTPLATFORM_RESTORE_DRILL_REQUIRED=1

# Optional absolute overrides for nonstandard PostgreSQL client installations.
# CLIENTPLATFORM_PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
# CLIENTPLATFORM_PG_RESTORE_PATH=/usr/lib/postgresql/16/bin/pg_restore
# CLIENTPLATFORM_PSQL_PATH=/usr/lib/postgresql/16/bin/psql

# Offsite upload and freshness remain disabled until the encrypted pipeline is
# manually proven against the dedicated versioned backup bucket. The metadata
# object is uploaded last and latest.json is checked independently by systemd.
CLIENTPLATFORM_POSTGRES_BACKUP_S3_ENABLED=0
CLIENTPLATFORM_POSTGRES_BACKUP_S3_PREFIX=postgres
CLIENTPLATFORM_POSTGRES_BACKUP_S3_EVIDENCE_DIR=/var/lib/clientplatform/postgres-backup-s3-evidence
CLIENTPLATFORM_POSTGRES_BACKUP_FRESHNESS_REQUIRED=0
CLIENTPLATFORM_POSTGRES_BACKUP_MAX_AGE_SECONDS=10800

# Runtime state is outside the repository.
LOG_PATH=/var/log/clientplatform/app.log
TIMEZONE=Europe/Amsterdam
VALIDATOR_RELEASE_MODE=1
VALIDATOR_GUARDRAILS_STRICT=1
APP_SELF_HEAL_RESTART=0
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Payment providers stay disabled until their production credentials are provisioned.
# Pricing is still explicit here so enabling Telegram Stars cannot silently fall back
# to a legacy buyer-parity ladder.
AI_ENABLED=0