{$CLIENTPLATFORM_DOMAIN} {
    encode zstd gzip

    # Telegram is polling-only. Only webhook-native providers use HTTP ingress.
    @messenger_webhooks path /webhooks/*
    handle @messenger_webhooks {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    @ad_oauth path /oauth/yandex-direct/callback
    handle @ad_oauth {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    @payment_http path /terms /pay/*
    handle @payment_http {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    # U-006 Growth Cockpit is authenticated by Telegram initData on the app
    # ingress.  Keep the public surface explicit instead of exposing 8181.
    @growth_cockpit path /dashboard/growth /api/clientplatform/growth-cockpit
    handle @growth_cockpit {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    @media path /clientplatform/*
    handle @media {
        reverse_proxy {$CLIENTPLATFORM_MEDIA_UPSTREAM:127.0.0.1:8191}
    }

    handle /healthz {
        respond "not public" 404
    }

    handle /readyz {
        respond "not public" 404
    }

    handle / {
        respond "ClientPlatform" 200
    }

    handle {
        respond "not found" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Keep access logs on stdout so the non-root Caddy container does not need
    # write access to the shared application log volume.
    log {
        output stdout
        format json
    }
}
