{$CLIENTPLATFORM_DOMAIN} {
    encode zstd gzip

    # Telegram is polling-only. Only webhook-native providers use HTTP ingress.
    @messenger_webhooks path /webhooks/*
    handle @messenger_webhooks {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    # Canonical tenant-scoped VK/MAX ingress must win over the broad
    # /clientplatform/* media matcher below. Route UUID + provider secret are
    # resolved by the application; no business_id is trusted from the request.
    @clientplatform_messenger_webhooks path /clientplatform/open/* /clientplatform/webhooks/vk/* /clientplatform/webhooks/max/* /clientplatform/connect/*
    handle @clientplatform_messenger_webhooks {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    # The authenticated Telegram Mini App is an application HTTP surface, not media.
    # Keep it ahead of the broad /clientplatform/* media matcher. Tenant and role
    # authorization still happen server-side on every context bootstrap.
    @clientplatform_cockpit path /clientplatform/cockpit /clientplatform/cockpit/*
    handle @clientplatform_cockpit {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    @ad_oauth path /oauth/yandex-direct/callback
    handle @ad_oauth {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    @payment_http path /terms /pay/*
    handle @payment_http {
        reverse_proxy {$CLIENTPLATFORM_INGRESS_UPSTREAM:127.0.0.1:8181}
    }

    @media path /clientplatform/*
    handle @media {
        reverse_proxy {$CLIENTPLATFORM_MEDIA_UPSTREAM:127.0.0.1:8191}
    }

    handle /healthz {
        respond "not public" 404
    }

    handle /readyz {
        respond "not public" 404
    }

    handle / {
        respond "ClientPlatform" 200
    }

    handle {
        respond "not found" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Keep access logs on stdout so the non-root Caddy container does not need
    # write access to the shared application log volume.
    log {
        output stdout
        format json
    }
}
